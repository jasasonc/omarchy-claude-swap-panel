#!/usr/bin/bash -p
# Add Claude accounts to claude-swap. The panel opens this script in a terminal
# through `env -i`, so it starts with a closed environment: HOME, TERM, LANG,
# XDG_RUNTIME_DIR, WAYLAND_DISPLAY, PATH=/usr/bin:/bin, and CLAUDE_CONFIG_DIR
# if the shell has it. System tools run from absolute paths. claude and cswap
# run only from fixed places in the home directory, after the checks of
# `cswap-panel resolve`.
set -uo pipefail
PATH=/usr/bin:/bin

case ${HOME:-} in
  /*) ;;
  *) echo "HOME is not an absolute path."; exit 1 ;;
esac

panel=${BASH_SOURCE[0]%/*}/cswap-panel
case $panel in
  /*) ;;
  *) echo "Start this script with its absolute path."; exit 1 ;;
esac

# cswap-panel tries only fixed candidates. It checks every folder and symlink
# on the way, the program file and its #! interpreter. `resolve` prints the
# path; its reasons are hidden here and show below if nothing passes. `run`
# starts the program through the descriptor that passed the checks, so a
# name cannot point somewhere else between the check and the start.
resolve() {
  /usr/bin/python3 -I -B "$panel" resolve "$1" 2>/dev/null
}

run() {
  /usr/bin/python3 -I -B "$panel" exec "$@"
}

cswap=$(resolve cswap)
claude=$(resolve claude)

finish() {
  trap - INT
  [[ -f $panel ]] && /usr/bin/python3 -I -B "$panel" run --timeout 150 --max-out 65536 --max-err 65536 \
    -- /usr/bin/python3 -I -B "$panel" bridge >/dev/null 2>&1
  echo
  read -r -p "Press Enter to close. " _
  exit "${1:-0}"
}

stop() {
  echo
  echo "$1"
  finish 1
}

# Prints "email org-id" of the Claude Code login, or nothing when logged out.
login_id() {
  run claude auth status --json 2>/dev/null | /usr/bin/head -c 65536 | /usr/bin/python3 -I -B -c '
import json, sys
try:
  data = json.load(sys.stdin)
except ValueError:
  sys.exit()
if isinstance(data, dict) and data.get("loggedIn") and data.get("email"):
  print(str(data["email"])[:200], str(data.get("orgId") or "")[:200])
' 2>/dev/null
}

if [[ -z $cswap ]]; then
  /usr/bin/python3 -I -B "$panel" resolve cswap >/dev/null
  stop "claude-swap is not installed, or it failed the checks above. To install it, run: uv tool install claude-swap"
fi
if [[ -z $claude ]]; then
  /usr/bin/python3 -I -B "$panel" resolve claude >/dev/null
  stop "Claude Code (claude) is not installed, or it failed the checks above."
fi

before=$(login_id)
before_email=${before%% *}

echo "Add Claude accounts to claude-swap"
echo
if [[ -n $before ]]; then
  echo "Claude Code uses $before_email now. claude-swap saves this account first."
else
  echo "Claude Code is not logged in."
fi
echo "Then you log in with the account to add. The login opens in the browser."
echo "If the browser is signed in to claude.ai with a different account, the login uses that account. Sign out there first."
if /usr/bin/pgrep -x claude >/dev/null; then
  echo
  echo "Claude Code is open. During the login, open sessions change to the new account."
fi
echo
read -r -p "Press Enter to start, or Ctrl+C to stop. " _ || exit 0

if [[ -n $before ]]; then
  echo
  run cswap add || stop "claude-swap could not save $before_email. Nothing changed."
  echo
  read -r -p "Log in with another account now? [Y/n] " answer
  case "$answer" in [nN]*) finish ;; esac
fi

back_hint=""
[[ -n $before ]] && back_hint=" To go back to $before_email, run: cswap switch $before_email"
trap 'stop "Stopped.$back_hint"' INT

echo
run claude auth login || stop "The login did not complete.$back_hint"
after=$(login_id)
after_email=${after%% *}
[[ -n $after ]] || stop "Claude Code is not logged in.$back_hint"
[[ $after != "$before" ]] || stop "The login used $before_email again. Sign out of claude.ai in the browser, then try again."

echo
run cswap add || stop "claude-swap could not save $after_email.$back_hint"
trap - INT
echo
echo "claude-swap saved $after_email."

if [[ -n $before ]]; then
  read -r -p "Switch Claude Code back to $before_email? [Y/n] " answer
  case "$answer" in
    [nN]*) echo "Claude Code keeps $after_email." ;;
    *) run cswap switch "$before_email" || echo "The switch failed. Run: cswap switch $before_email" ;;
  esac
fi
finish
